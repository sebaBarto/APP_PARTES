{
  "crons": [
    {
      "path": "/api/cron-diario",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-diario",
      "schedule": "0 20 * * 1-5"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pedido.sat365.com.ar" }],
      "destination": "/solicitar-servicio.html"
    }
  ],
  "redirects": [
    {
      "source": "/admin.html",
      "has": [{ "type": "host", "value": "pedido.sat365.com.ar" }],
      "destination": "https://pedido.sat365.com.ar/",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "pedido.sat365.com.ar" }],
      "destination": "https://pedido.sat365.com.ar/",
      "permanent": false
    }
  ]
}
